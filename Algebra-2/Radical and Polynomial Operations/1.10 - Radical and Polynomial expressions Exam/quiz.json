    "questions": [
        { "worth": 1, "title": "Simplifica la expresión <math><msup><mfenced><mrow><mn>27</mn><msup><mi>x</mi><mn>6</mn></msup></mrow></mfenced><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow></msup></math>", "choices": ["<math><mn>9</mn><msup><mi>x</mi><mn>4</mn></msup></math>", "<math><mn>3</mn><msup><mi>x</mi><mn>4</mn></msup></math>", "<math><mn>9</mn><msup><mi>x</mi><mn>3</mn></msup></math>", "<math><mn>27</mn><msup><mi>x</mi><mn>4</mn></msup></math>"], "correct": 0, "explain": "27^(2/3) es (cúbica de 27)^2 = 3^2 = 9. (x^6)^(2/3) = x^(6*2/3) = x^4." },
        { "worth": 1, "title": "Resuelve la ecuación radical: <math><msqrt><mrow><mi>x</mi><mo>+</mo><mn>7</mn></mrow></msqrt><mo>-</mo><mi>x</mi><mo>=</mo><mn>1</mn></math>", "choices": ["<math><mi>x</mi><mo>=</mo><mn>2</mn></math>", "<math><mi>x</mi><mo>=</mo><mo>-</mo><mn>3</mn></math>", "<math><mi>x</mi><mo>=</mo><mn>2</mn><mo>,</mo><mo>-</mo><mn>3</mn></math>", "<math><mtext>No tiene solución</mtext></math>"], "correct": 0, "explain": "x+7 = (x+1)^2 => x+7 = x^2+2x+1 => x^2+x-6=0 => (x+3)(x-2)=0. x=2 es la única válida." },
        { "worth": 1, "title": "Simplifica el producto de números complejos: <math><mfenced><mrow><mn>3</mn><mo>+</mo><mn>2</mn><mi>i</mi></mrow></mfenced><mfenced><mrow><mn>1</mn><mo>-</mo><mn>4</mn><mi>i</mi></mrow></mfenced></math>", "choices": ["<math><mn>3</mn><mo>-</mo><mn>8</mn><mi>i</mi></math>", "<math><mn>11</mn><mo>-</mo><mn>10</mn><mi>i</mi></math>", "<math><mo>-</mo><mn>9</mn><mo>-</mo><mn>10</mn><mi>i</mi></math>", "<math><mn>11</mn><mo>-</mo><mn>14</mn><mi>i</mi></math>"], "correct": 1, "explain": "3 - 12i + 2i - 8i^2 = 3 - 10i + 8 = 11 - 10i." },
        { "worth": 1, "title": "¿Cuál es la forma simplificada de <math><msup><mi>i</mi><mn>25</mn></msup><mo>+</mo><msup><mi>i</mi><mn>26</mn></msup></math>?", "choices": ["<math><mn>0</mn></math>", "<math><mn>1</mn><mo>+</mo><mi>i</mi></math>", "<math><mo>-</mo><mn>1</mn><mo>+</mo><mi>i</mi></math>", "<math><mn>1</mn><mo>-</mo><mi>i</mi></math>"], "correct": 2, "explain": "i^25 = i, i^26 = -1. Suma: -1 + i." },
        { "worth": 1, "title": "Suma los polinomios: <math><mfenced><mrow><mn>5</mn><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>3</mn><mi>x</mi><mo>+</mo><mn>8</mn></mrow></mfenced><mo>+</mo><mfenced><mrow><mn>2</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>7</mn><mi>x</mi><mo>-</mo><mn>4</mn></mrow></mfenced></math>", "choices": ["<math><mn>7</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>4</mn><mi>x</mi><mo>+</mo><mn>4</mn></math>", "<math><mn>7</mn><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>10</mn><mi>x</mi><mo>+</mo><mn>4</mn></math>", "<math><mn>3</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>4</mn><mi>x</mi><mo>+</mo><mn>12</mn></math>", "<math><mn>7</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>10</mn><mi>x</mi><mo>+</mo><mn>4</mn></math>"], "correct": 0, "explain": "Combinando términos semejantes: 5+2=7, -3+7=4, 8-4=4." },
        { "worth": 1, "title": "Resta: <math><mfenced><mrow><mn>4</mn><msup><mi>x</mi><mn>3</mn></msup><mo>-</mo><mn>2</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>5</mn></mrow></mfenced><mo>-</mo><mfenced><mrow><msup><mi>x</mi><mn>3</mn></msup><mo>-</mo><mn>3</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn></mrow></mfenced></math>", "choices": ["<math><mn>3</mn><msup><mi>x</mi><mn>3</mn></msup><mo>+</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>3</mn></math>", "<math><mn>3</mn><msup><mi>x</mi><mn>3</mn></msup><mo>-</mo><mn>5</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>7</mn></math>", "<math><mn>5</mn><msup><mi>x</mi><mn>3</mn></msup><mo>+</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>3</mn></math>", "<math><mn>3</mn><msup><mi>x</mi><mn>3</mn></msup><mo>+</mo><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>3</mn></math>"], "correct": 0, "explain": "4-1=3, -2-(-3)=1, 5-2=3." },
        { "worth": 1, "title": "¿Cuál es el residuo de dividir <math><msup><mi>x</mi><mn>3</mn></msup><mo>-</mo><mn>2</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mi>x</mi><mo>-</mo><mn>5</mn></math> entre <math><mfenced><mrow><mi>x</mi><mo>-</mo><mn>2</mn></mrow></mfenced></math>?", "choices": ["<math><mn>0</mn></math>", "<math><mo>-</mo><mn>3</mn></math>", "<math><mn>5</mn></math>", "<math><mo>-</mo><mn>5</mn></math>"], "correct": 1, "explain": "Por el teorema del residuo: P(2) = 2^3 - 2(2^2) + 2 - 5 = 8 - 8 + 2 - 5 = -3." },
        { "worth": 1, "title": "Divide <math><mfenced><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>5</mn><mi>x</mi><mo>+</mo><mn>6</mn></mrow></mfenced></math> entre <math><mfenced><mrow><mi>x</mi><mo>+</mo><mn>2</mn></mrow></mfenced></math>", "choices": ["<math><mi>x</mi><mo>+</mo><mn>3</mn></math>", "<math><mi>x</mi><mo>-</mo><mn>3</mn></math>", "<math><mi>x</mi><mo>+</mo><mn>2</mn></math>", "<math><mi>x</mi><mo>-</mo><mn>2</mn></math>"], "correct": 0, "explain": "(x+2)(x+3) = x^2+5x+6." },
        { "worth": 1, "title": "Si <math><mi>f</mi><mfenced><mi>x</mi></mfenced><mo>=</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></math> y <math><mi>g</mi><mfenced><mi>x</mi></mfenced><mo>=</mo><mi>x</mi><mo>-</mo><mn>3</mn></math>, ¿qué es <math><mi>f</mi><mfenced><mrow><mi>g</mi><mfenced><mi>x</mi></mfenced></mrow></mfenced></math>?", "choices": ["<math><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>2</mn></math>", "<math><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>6</mn><mi>x</mi><mo>+</mo><mn>10</mn></math>", "<math><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>6</mn><mi>x</mi><mo>+</mo><mn>10</mn></math>", "<math><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>6</mn><mi>x</mi><mo>-</mo><mn>8</mn></math>"], "correct": 1, "explain": "(x-3)^2 + 1 = x^2 - 6x + 9 + 1 = x^2 - 6x + 10." },
        { "worth": 1, "title": "Multiplica <math><mfenced><mrow><mi>x</mi><mo>+</mo><mn>5</mn></mrow></mfenced><mfenced><mrow><mi>x</mi><mo>-</mo><mn>5</mn></mrow></mfenced></math>", "choices": ["<math><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>25</mn></math>", "<math><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>10</mn><mi>x</mi><mo>-</mo><mn>25</mn></math>", "<math><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>25</mn></math>", "<math><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>10</mn><mi>x</mi><mo>+</mo><mn>25</mn></math>"], "correct": 2, "explain": "Diferencia de cuadrados: a^2 - b^2." },
        { "worth": 1, "title": "¿Cuál es el conjugado de <math><mn>5</mn><mo>+</mo><mn>3</mn><mi>i</mi></math>?", "choices": ["<math><mo>-</mo><mn>5</mn><mo>-</mo><mn>3</mn><mi>i</mi></math>", "<math><mn>5</mn><mo>-</mo><mn>3</mn><mi>i</mi></math>", "<math><mo>-</mo><mn>5</mn><mo>+</mo><mn>3</mn><mi>i</mi></math>", "<math><mn>3</mn><mo>-</mo><mn>5</mn><mi>i</mi></math>"], "correct": 1, "explain": "El conjugado cambia el signo de la parte imaginaria." },
        { "worth": 1, "title": "Simplifica <math><msqrt><mrow><mo>-</mo><mn>16</mn></mrow></msqrt></math>", "choices": ["<math><mn>4</mn></math>", "<math><mo>-</mo><mn>4</mn></math>", "<math><mn>4</mn><mi>i</mi></math>", "<math><mo>-</mo><mn>4</mn><mi>i</mi></math>"], "correct": 2, "explain": "sqrt(-16) = sqrt(16) * sqrt(-1) = 4i." },
        { "worth": 1, "title": "Calcula <math><mfrac><mrow><mn>2</mn><mo>+</mo><mi>i</mi></mrow><mi>i</mi></mfrac></math>", "choices": ["<math><mn>1</mn><mo>+</mo><mn>2</mn><mi>i</mi></math>", "<math><mn>1</mn><mo>-</mo><mn>2</mn><mi>i</mi></math>", "<math><mo>-</mo><mn>1</mn><mo>+</mo><mn>2</mn><mi>i</mi></math>", "<math><mn>2</mn><mo>-</mo><mi>i</mi></math>"], "correct": 1, "explain": "Multiplicar arriba y abajo por -i: (2+i)(-i) / (1) = -2i - i^2 = -2i + 1 = 1 - 2i." },
        { "worth": 1, "title": "¿Qué valor de <math><mi>k</mi></math> hace que <math><msup><mi>x</mi><mn>2</mn></msup><mo>-</mo><mn>8</mn><mi>x</mi><mo>+</mo><mi>k</mi></math> sea un trinomio cuadrado perfecto?", "choices": ["<math><mn>8</mn></math>", "<math><mo>-</mo><mn>16</mn></math>", "<math><mn>16</mn></math>", "<math><mn>64</mn></math>"], "correct": 2, "explain": "(b/2)^2 = (-8/2)^2 = (-4)^2 = 16." },
